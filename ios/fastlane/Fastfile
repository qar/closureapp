default_platform(:ios)

platform :ios do
  # Creates the App Store Connect record (and the App ID if it is missing), which
  # reserves the name. Apple offers no API for creating apps, so this signs in with
  # the Apple ID and asks for the password and a two-factor code.
  desc "Create the Papermoon app record on App Store Connect"
  lane :create_app do
    produce(
      app_name: "Papermoon",
      language: "en-US",
      sku: "papermoon-ios",
      app_version: "0.1",
      platform: "ios",
      # Xcode's automatic signing may already have registered the App ID.
      skip_itc: false,
      enable_services: {}
    )
  end
end
