default_platform(:ios)

# App Store Connect API key from the environment, when it is set there
# (APP_STORE_CONNECT_API_KEY_ID, APP_STORE_CONNECT_API_KEY_ISSUER_ID and the .p8 in
# ~/.appstoreconnect/private_keys). Without it, fastlane signs in with the Apple ID.
def asc_api_key
  key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
  return nil if key_id.nil? || issuer_id.nil?
  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: asc_key_path,
    in_house: false
  )
end

def require_api_key!
  UI.user_error!("Set APP_STORE_CONNECT_API_KEY_ID and APP_STORE_CONNECT_API_KEY_ISSUER_ID (ios/fastlane/.env)") if asc_api_key.nil?
end

def asc_key_path
  File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['APP_STORE_CONNECT_API_KEY_ID']}.p8")
end

# xcodebuild flags that let -exportArchive sign and upload with the API key, so no
# Apple ID has to be added to Xcode.
def xcodebuild_auth_args
  "-allowProvisioningUpdates -authenticationKeyPath #{asc_key_path} " \
    "-authenticationKeyID #{ENV['APP_STORE_CONNECT_API_KEY_ID']} " \
    "-authenticationKeyIssuerID #{ENV['APP_STORE_CONNECT_API_KEY_ISSUER_ID']}"
end

platform :ios do
  # Creates the App Store Connect record (and the App ID if it is missing), which
  # reserves the name. Apple offers no API for creating apps, so this signs in with
  # the Apple ID and asks for the password and a two-factor code.
  desc "Create the Papermoon app record on App Store Connect"
  # "Papermoon" alone is taken on App Store Connect (2026-11-17); the brand stays
  # Papermoon with a descriptive suffix. Try another with: fastlane create_app name:"Papermoon Player"
  lane :create_app do |options|
    produce(
      app_name: options[:name] || "Papermoon Music",
      language: "en-US",
      sku: "papermoon-ios",
      app_version: "0.1",
      platform: "ios",
      # Xcode's automatic signing may already have registered the App ID.
      skip_itc: false,
      enable_services: {}
    )
  end

  # Uploads the store text in fastlane/metadata (English and Simplified Chinese) to
  # version 0.0.1. No binary, no screenshots, nothing is submitted for review.
  desc "Upload App Store metadata for 0.0.1"
  lane :upload_metadata do
    deliver(
      api_key: asc_api_key,
      app_version: "0.0.1",
      skip_binary_upload: true,
      skip_screenshots: true,
      # Apple's new age-rating questionnaire makes fastlane fail with "No data" on a
      # first version; the rating and categories are set on the website instead.
      skip_app_version_update: false,
      ignore_language_directory_validation: true,
      force: true,
      submit_for_review: false,
      run_precheck_before_submit: false
    )
  end

  # Pulls the store text that is on App Store Connect into fastlane/metadata, to
  # compare with what we have (git diff shows the differences).
  desc "Download the current App Store metadata"
  lane :fetch_metadata do
    require_api_key!
    key_file = File.join(Dir.tmpdir, "papermoon-asc-key.json")
    File.write(key_file, { key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"], issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
                           key: File.read(asc_key_path), in_house: false }.to_json)
    begin
      sh("fastlane deliver download_metadata --api_key_path #{key_file} --app_version 0.0.1 --force")
    ensure
      File.delete(key_file) if File.exist?(key_file)
    end
  end

  # Builds the Release archive into build/Papermoon.xcarchive (generic iOS device).
  # Signing uses the API key, so no Apple ID has to be added to Xcode.
  desc "Archive the app into build/Papermoon.xcarchive"
  lane :archive do
    require_api_key!
    FileUtils.rm_rf(File.expand_path("../build/Papermoon.xcarchive"))
    sh("xcodebuild -project '#{File.expand_path('../Closure.xcodeproj')}' -scheme Closure -configuration Release " \
       "-destination 'generic/platform=iOS' archive -archivePath '#{File.expand_path('../build/Papermoon.xcarchive')}' " \
       "#{xcodebuild_auth_args} | grep -E '^(\\*\\*|error:|warning:.*deprecat|.*error)' || true")
    UI.user_error!("Archive failed") unless File.directory?(File.expand_path("../build/Papermoon.xcarchive/Products"))
  end

  # Signs build/Papermoon.xcarchive for the App Store and uploads it (ExportOptions
  # has destination "upload"). Signing and upload use the API key; no Apple ID has
  # to be added to Xcode. Takes a few minutes; the build then shows up in TestFlight
  # and can be attached to version 0.0.1.
  desc "Sign build/Papermoon.xcarchive and upload the build to App Store Connect"
  lane :upload_build do |options|
    require_api_key!
    archive = File.expand_path(options[:archive] || "../build/Papermoon.xcarchive")
    UI.user_error!("No archive at #{archive}") unless File.directory?(archive)
    sh("xcodebuild -exportArchive -archivePath '#{archive}' " \
       "-exportOptionsPlist '#{File.expand_path('../ExportOptions-AppStore.plist')}' " \
       "-exportPath '#{File.expand_path('../build/export')}' #{xcodebuild_auth_args}")
  end
end
