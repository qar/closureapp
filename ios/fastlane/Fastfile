default_platform(:ios)

# App Store Connect API key from the environment, when it is set there
# (APP_STORE_CONNECT_API_KEY_ID, APP_STORE_CONNECT_API_KEY_ISSUER_ID and the .p8 in
# ~/.appstoreconnect/private_keys). Without it, fastlane signs in with the Apple ID.
def asc_api_key
  key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
  return nil if key_id.nil? || issuer_id.nil?
  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
  )
end

platform :ios do
  # Creates the App Store Connect record (and the App ID if it is missing), which
  # reserves the name. Apple offers no API for creating apps, so this signs in with
  # the Apple ID and asks for the password and a two-factor code.
  desc "Create the Papermoon app record on App Store Connect"
  # "Papermoon" alone is taken on App Store Connect (2026-11-17); the brand stays
  # Papermoon with a descriptive suffix. Try another with: fastlane create_app name:"Papermoon Player"
  lane :create_app do |options|
    produce(
      app_name: options[:name] || "Papermoon Music",
      language: "en-US",
      sku: "papermoon-ios",
      app_version: "0.1",
      platform: "ios",
      # Xcode's automatic signing may already have registered the App ID.
      skip_itc: false,
      enable_services: {}
    )
  end

  # Uploads the store text in fastlane/metadata (English and Simplified Chinese) to
  # version 0.0.1. No binary, no screenshots, nothing is submitted for review.
  desc "Upload App Store metadata for 0.0.1"
  lane :upload_metadata do
    deliver(
      api_key: asc_api_key,
      app_version: "0.0.1",
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: false,
      run_precheck_before_submit: false
    )
  end
end
